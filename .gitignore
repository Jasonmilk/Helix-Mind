# Rust build artifacts
/target/
**/*.rs.bk

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Local configuration files (may contain API keys or personal data)
config.toml
gene_lock.md

# Runtime data directories
data/
federation/

# Model files (too large for Git)
models/*.onnx
models/*.bin

# Temporary files
*.tmp
*.log

# =======================================================
# LunarAST Project .gitignore (v1.6)
# =======================================================

# Physical facts cache (auto-generated by AST scan)
.lunar/.interfaces-autogen.json

# Auto backup directory (created by patch merge)
.lunar/.backup/

# AI/human patch staging directory
.lunar/suggestions/

# Audit logs and task archive (local runtime data)
.lunar/access-logs/

# Runtime process file (regenerated on every serve start)
.lunar/lunar-serve.pid

# Sensitive cryptographic private key (NEVER commit)
.lunar/lct-secret.key

# -------------------------------------------------------
# Required (NOT ignored):
# - .lunar/interfaces.yml  →  interface contract, must be tracked
# - lunar-map.json         →  global topography map (your choice to track)
#
# Optional: uncomment below to ignore AI todo for solo development
# -------------------------------------------------------
# .lunar/ai-todo.json
