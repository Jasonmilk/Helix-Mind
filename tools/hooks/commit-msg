#!/usr/bin/env bash
# Large-diff gate, driven by the commit message rather than an environment
# variable.
#
# An env var is invisible to `git log`: who skipped the gate and why becomes
# unrecoverable, and habit makes people carry it permanently — at which point
# the gate is decoration, which is exactly the failure it exists to prevent
# (the third overwrite was committed after the author saw "+62/-258").
#
# A marker in the message is auditable:  git log --grep='\[large\]'
#
# Why this is the general solution and a content check is not: the four
# overwrites on 2026-09-15/16 had one physical shape in common — the whole file
# was replaced. That shows up as hundreds of changed lines. It does not require
# knowing what the pollution looks like, so it cannot be outrun by wording.
#
#   [large] 重建 ADR 索引（36 份）
set -u

LARGE_DIFF_MAX="${LARGE_DIFF_MAX:-50}"
MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

if grep -q '\[large\]' "$MSG_FILE" 2>/dev/null; then
  exit 0
fi

stat="$(git diff --cached --shortstat 2>/dev/null || true)"
[ -n "$stat" ] || exit 0

# --numstat is a machine format (added, deleted, path) — no human text to parse
# and no dialect to get wrong. The previous version used --shortstat plus sed,
# and macOS sed silently matched nothing (BRE treats \+ as a literal), so the
# gate computed 0 and passed everything for as long as it existed.
numstat="$(git diff --cached --numstat 2>/dev/null || true)"

# Only GUARDED paths count. Tests, fixtures and inline test data are data, not
# logic, and being large is their nature — the gate kept firing on exactly the
# change it should encourage (putting a real period slice into the net). Three
# consecutive [large] markers is how a gate becomes a ritual, and a ritual is a
# gate nobody reads.
#
# Source, assets and ADRs keep the tight limit: replacing one of those wholesale
# is the shape all four overwrites had.
GUARDED='^(web/assets/|web/src/|docs/decisions/)'
total=$(printf '%s\n' "$numstat" | awk -v re="$GUARDED" 'NF>=3 && $3 ~ re {a+=$1} NF>=3 && $3 ~ re && $2 ~ /^[0-9]+$/ {a+=$2} END {print a+0}')
skipped=$(printf '%s\n' "$numstat" | awk -v re="$GUARDED" 'NF>=3 && $3 !~ re {a+=$1} NF>=3 && $3 !~ re && $2 ~ /^[0-9]+$/ {a+=$2} END {print a+0}')

# Fail LOUD on a parse that yields nothing while the input is non-empty: that
# is a broken parser, not a small diff. Failing open here is how the gate died
# silently the first time.
if [ -n "$numstat" ] && [ "${total:-0}" = "0" ] && [ "${skipped:-0}" = "0" ]; then
  echo "REJECT: numstat 非空但解析出 0 —— 解析器坏了，拒绝放行"
  printf '%s\n' "$numstat" | head -3 | sed 's/^/        /'
  exit 1
fi

if [ "$total" -gt "$LARGE_DIFF_MAX" ]; then
  echo "REJECT: guarded diff is $total lines (limit $LARGE_DIFF_MAX); unguarded $skipped"
  echo "        大改动常常是「整份被替换」，而不是「逐处修改」。"
  echo "        确认这是本意后，在提交信息里写明："
  echo "            [large] <为什么这次改动这么大>"
  exit 1
fi
exit 0
