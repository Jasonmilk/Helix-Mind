#!/usr/bin/env bash
# One gate: an ADR whose first line is not an ADR header is refused.
#
# Four times on 2026-09-15/16 a file was replaced by the full text of a chat
# reply; the first line gave it away each time. The check calls
# tools/adr_head.py — the ONE parser for that fact — rather than carrying its
# own regex.
#
# The other gate (diff magnitude) is in commit-msg, because it reads the
# [large] marker from the commit message and this hook runs before one exists.
#
# Install with tools/install-hooks.sh (core.hooksPath), not by copying.
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARSER="$HERE/../adr_head.py"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
fail=0

# ---------------------------------------------------------------- gate 1: ADRs
# `ADR-*.md` only. A `*.md` glob also catches the index README and, in repos
# whose history predates the convention, files named `0001-<title>.md` — real
# ADRs that simply do not carry the prefix. Those are not defects and must not
# be reported as pollution.
adrs="$(git diff --cached --name-only --diff-filter=ACM -- 'docs/decisions/ADR-*.md' 2>/dev/null || true)"
if [ -n "$adrs" ]; then
  # FAIL-OPEN. A gate that cannot run must not block work: if the parser or the
  # interpreter is missing, say so and let the commit through. A hook that
  # refuses everything is a 100%-coverage, zero-assertion test — it would also
  # mean that moving this directory makes the repo uncommittable.
  if ! command -v python3 > /dev/null 2>&1 || [ ! -f "$PARSER" ]; then
    echo "WARN: ADR 首行检查已跳过（fail-open）—— $(command -v python3 > /dev/null 2>&1 && echo "解析器缺失: $PARSER" || echo "python3 不可用")"
    adrs=""
  fi
fi
if [ -n "$adrs" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$ROOT/$f" ] || continue
    if ! python3 "$PARSER" "$ROOT/$f" > /dev/null 2>&1; then
      echo "REJECT: $f 首行不是 ADR 头 —— 疑似回复正文被整份写入"
      head -1 "$ROOT/$f" | cut -c1-70 | sed 's/^/        /'
      echo "        (解析器: ${PARSER#$ROOT/})"
      fail=1
    fi
  done <<EOF
$adrs
EOF
fi


# ------------------------------------------------- gate 3: staged ledger is valid
# Three times in one week a ledger row was committed RED: the evidence column held
# prose instead of a resolvable path::symbol, and the criterion said so -- after the
# commit existed. Writing a fourth lesson was tried and did not work; the answer is a
# vending-machine check: refusals belong at the moment of the act, not in a memory.
#   (类比：与其培训收银员别收假钞，不如在收银台装验钞机)
ledger_staged=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E 'consensus-ledger\.md$' || true)
if [ -n "$ledger_staged" ]; then
  checker="$ROOT/../anaphase-helix/ci/check_ci144_profile.py"
  if [ -f "$checker" ]; then
    if ! python3 "$checker" --root "$ROOT" --file "docs/helixECO/consensus-ledger.md" > /tmp/ledger_gate.out 2>&1; then
      echo "REJECT: 台账本行不合法（判据原文如下）"
      sed 's/^/        /' /tmp/ledger_gate.out
      echo "        修好再提交：evidence 列是可解析证据位，不是写说明的地方。"
      fail=1
    fi
  fi
fi

# Gate 2 (diff magnitude) lives in commit-msg, not here — it needs the commit
# message to read the [large] marker, and this hook runs before there is one.
# Keeping a copy here would mean two implementations of one rule, which is the
# shape Cellrix:ADR-0018 exists to remove.

# ------------------------------------------------- gate: 术语准入层（H4）
# 存量十基因名合格 ≠ 新命名不会绕过（自我测过：仅"双面非空"会放行
# Unavailable = 没有应答者或应答者失败 这种合并语义）。
if git diff --cached --name-only 2>/dev/null | grep -qE '^governance/terms\.toml$'; then
  if ! python3 "$(cd "$(dirname "$0")" && pwd)/../check-terms.py" --naming >/tmp/terms_gate.out 2>&1; then
    echo "REJECT: 术语准入层未过（判据原文如下）"
    sed 's/^/        /' /tmp/terms_gate.out
    exit 1
  fi
fi

# ------------------------------------------------- gate: anaphase 行预算（点名，不计数）
# 根因不是"两份快照"，是**把判据建在计数上**：续期一条豁免会让 over300 与过期豁免
# 两个数字同时变（实测 9→8 / 4→3）⇒ 计数天生脆弱。改成**点名集合**：
#   本次 FAIL 里出现的文件，必须 ⊆ 已登记清单；多出任何一个 ⇒ 拦。
# 合法重基线是有人在场、低频、走 --emit-ratchet 正门的动作 ⇒ 属于适用域例外：
#   重基线后同步更新本清单即可（一个对象，不是第三层参照系）。
ANAPHASE_DIR="$(cd "$(dirname "$0")/../../../anaphase-helix" 2>/dev/null && pwd)"
BASE_LIST="$(cd "$(dirname "$0")/../.." && pwd)/governance/anaphase-line-budget-baseline.txt"
if [ -n "${ANAPHASE_DIR:-}" ] && [ -f "$ANAPHASE_DIR/ci/check_line_budget.py" ]; then
  out=$( cd "$ANAPHASE_DIR" && python3 ci/check_line_budget.py 2>&1 ); rc=$?
  now=$(printf '%s\n' "$out" | grep '^FAIL' | grep -oE 'src/[A-Za-z0-9_/.-]+\.rs' | sort -u)
  if [ ! -f "$BASE_LIST" ]; then
    echo "REJECT: 行预算基线清单缺失（$BASE_LIST）—— 读到空不是通过"; exit 1
  fi
  # 洞：检查器自身报错（新文件缺 seed）时**一条 FAIL 行都没有** ⇒ 空集 ⊆ 基线 ⇒ 假绿。
  # 读到空必须是具名故障，不是通过。
  if [ "$rc" != 0 ] && [ -z "$now" ]; then
    echo "REJECT: 行预算检查器报错且无 FAIL 行（读到空不是通过）"
    printf '%s\n' "$out" | head -3 | sed 's/^/        /'
    exit 1
  fi
  extra=$(comm -13 "$BASE_LIST" <(printf '%s\n' "$now") | sed '/^$/d')
  if [ -n "$extra" ]; then
    echo "REJECT: 行预算出现**未登记**的超标/过期文件（点名，不计数）："
    printf '%s\n' "$extra" | sed 's/^/        /'
    exit 1
  fi
  echo "        anaphase 行预算：FAIL 清单 ⊆ 已登记（${now:-空}），无新增"
else
  echo "        anaphase 行预算：UNMEASURABLE（兄弟仓不在本机，不判绿也不判红）"
fi

exit $fail
